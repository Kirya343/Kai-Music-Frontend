{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "paths": {
            
            "@user": ["./src/lib/user/index.ts"],

            "@audio": ["./src/lib/audio/index.ts"],

            "@room": ["./src/lib/room/index.ts"],

            "@playback": ["./src/lib/playback/index.ts"],

            "@playlist": ["./src/lib/playlist/index.ts"],

            "@websocket": ["./src/lib/websocket/index.ts"],

            "@permission": ["./src/lib/permission/index.ts"],

            "@common": ["./src/lib/common/index.ts"],

            "@/*": ["./src/*"]
        },

        "allowImportingTsExtensions": true,
        "strict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,

        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [ "src" ],
    "exclude": [
        "node_modules",
        "**/node_modules/*",
        "dist"
    ]
}
