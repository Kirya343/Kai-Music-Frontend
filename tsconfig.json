{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",

        "baseUrl": "./",
        "paths": {
            "@/*": ["src/*"],
            
            "@user": ["src/lib/user/index.ts"],
            "@user/*": ["src/lib/user/*"],

            "@audio": ["src/lib/audio/index.ts"],
            "@audio/*": ["src/lib/audio/*"],

            "@room": ["src/lib/room/index.ts"],
            "@room/*": ["src/lib/room/*"],

            "@websocket": ["src/lib/websocket/index.ts"],
            "@websocket/*": ["src/lib/websocket/*"],

            "@permission": ["src/lib/permission/index.ts"],
            "@permission/*": ["src/lib/permission/*"],

            "@common": ["src/lib/common/index.ts"],
            "@common/*": ["src/lib/common/*"],

            "@auth": ["src/lib/auth/index.ts"],
            "@auth/*": ["src/lib/auth/*"]
        },

        "allowImportingTsExtensions": true,
        "strict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,

        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [ "src" ],
    "exclude": [
        "node_modules",
        "**/node_modules/*",
        "dist"
    ]
}
